{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoSortX",
  "version": "0.1.0",
  "identifier": "com.photosortx.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "plugins": {
    "shell": {
      "open": true,
      "scope": [
        {
          "name": "python-api",
          "cmd": "python",
          "args": true,
          "sidecar": false
        },
        {
          "name": "uvicorn-api",
          "cmd": "uvicorn",
          "args": true,
          "sidecar": false
        }
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "PhotoSortX",
        "width": 1440,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}

